# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=philsar_db
# Set to "true" for managed hosts that require SSL (e.g. Railway)
DB_SSL=false
# Auto-migrates the schema on every boot when true (default). Set to "false" once
# schema changes become rare — safer for production, but you'll need to apply future
# schema changes manually.
DB_SYNC_ALTER=true

# Google Gemini API key (used for chatbot + DSS guidance generation)
GEMINI_API_KEY=

JWT_SECRET=

# Production only — the deployed frontend's URL, used to lock down CORS
FRONTEND_URL=
# Production only — this backend's own public URL, used to build uploaded-file links
# when Cloudinary isn't configured (see below)
BACKEND_URL=

# Optional — when all three are set, uploaded images (module covers, avatars,
# certificate backgrounds) go to Cloudinary instead of local disk. Required in
# production on platforms with an ephemeral filesystem (e.g. Railway), since anything
# written to local disk there is lost on every redeploy. Get these from your
# Cloudinary dashboard's "Product Environment Credentials" section.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — when both are set, password-reset emails send via Brevo's HTTP API.
# When unset, the reset link is just logged to the console instead (local dev).
# Get the API key from Brevo: Settings > SMTP & API > API Keys.
# BREVO_SENDER_EMAIL must be a sender you've verified in Brevo (Senders, Domains
# & Dedicated IPs > Senders) — Brevo rejects sends from unverified senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional — when set, sign-ups are refused if the email's mailbox doesn't exist,
# checked through Abstract's email API (free plan: 100 requests a month). When
# unset, or once the monthly limit is reached, only the built-in checks run
# (format, typos, throwaway inboxes, domain can receive mail).
# Copy the key from your Abstract dashboard's Email Validation (or Email
# Reputation) API page; either one works.
ABSTRACT_API_KEY=
